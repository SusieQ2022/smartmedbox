# SmartMedBox configuration

# Use a local .env file for real credentials. Do not commit secrets.
KICONNECT_API_KEY=
KICONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1

# Model selection for the OpenAI-compatible Ki:connect endpoint.
LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o

# Optional direct OpenAI fallback, if used by your team.
OPENAI_API_KEY=

# Optional caregiver notification via Twilio.
CAREGIVER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Device and demo settings.
NUM_COMPARTMENTS=4
LANGUAGE=en
REMINDER_INTERVAL_MIN=15
HARDWARE_MODE=mock

# Local adherence event database. Runtime .db files are gitignored.
SMARTMEDBOX_DB=smartmedbox.db
