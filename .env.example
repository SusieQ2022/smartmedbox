# ── SmartMedBox Configuration ──

# OpenAI API key (required for LLM reasoning + vision confirmation)
OPENAI_API_KEY=sk-your-key-here

# LLM model selection
LLM_MODEL=gpt-4o
VISION_MODEL=gpt-4o

# Caregiver notification (optional — leave blank to disable)
CAREGIVER_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Device settings
NUM_COMPARTMENTS=4
LANGUAGE=en
REMINDER_INTERVAL_MIN=15

# Hardware mode: 'real' for Raspberry Pi, 'mock' for development on laptop
HARDWARE_MODE=mock
